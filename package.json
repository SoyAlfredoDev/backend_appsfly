{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "start": "node index.js",
    "postinstall": "prisma generate --schema=prisma/businessDB/schema.prisma && prisma generate --schema=prisma/generalDB/schema.prisma",
    "migrate:general": "prisma migrate deploy --schema=prisma/generalDB/schema.prisma",
    "migrate:tenants": "node prisma/runUpdate.js",
    "migrate:all": "node scripts/migrateAllDatabases.js",
    "migrate:deploy": "npm run migrate:general && npm run migrate:tenants",
    "cleanup:daily-sales": "node scripts/cleanupDailySalesDuplicates.js",
    "cleanup:daily-sales:dry-run": "node scripts/cleanupDailySalesDuplicates.js --dry-run",
    "seed:plans": "node scripts/seedPlans.js",
    "seed:email-campaigns": "node scripts/seedEmailCampaigns.js",
    "import:prospects-xlsx": "node scripts/importProspectsFromXlsx.js",
    "agent-tasks:pending": "node scripts/listPendingAgentTasks.js",
    "agent-tasks:status": "node scripts/updateAgentTaskStatus.js"
  },
  "type": "module",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "@stackframe/js": "^2.8.49",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "resend": "^6.5.2",
    "svix": "^1.96.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^6.15.0"
  }
}

//npx prisma migrate dev --schema=prisma/generalDB/schema.prisma --name UserGuestID

generator client {
    provider      = "prisma-client-js"
    output        = "../../src/generated/general"
    binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_GENERAL_URL")
}

model User {
    userId              String    @id @default(uuid())
    userFirstName       String
    userLastName        String
    userEmail           String    @unique
    userConfirmEmail    Boolean   @default(false)
    userPassword        String
    userLastConnection  DateTime?
    userCodePhoneNumber String
    userPhoneNumber     String
    userDocumentType    String
    userDocumentNumber  String
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    // Relations
    UserBusiness  UserBusiness[]
    UserGuest     UserGuest[]
    businesses    Business[]
    subscriptions Subscription[]
    subscriptionPayments SubscriptionPayment[]
    subscriptionCancellations SubscriptionCancellation[]
    tickets       Ticket[]
    ticketDetails TicketDetail[]
    platformEmailCampaigns PlatformEmailCampaign[]
    agentTasks             PlatformAgentTask[]

}

model Business {
    businessId                 String         @id
    businessName               String
    businessType               String
    businessDocumentType       String
    businessDocumentNumber     String
    businessEmail              String
    businessPhoneNumber        String
    businessCodePhoneNumber    String
    businessCountry            String
    businessCodeWhatsappNumber String?
    businessWhatsappNumber     String?
    businessConnectionDB       String?
    businessEntity             BusinessEntity
    businessStatus             BusinessStatus
    businessProcess            Json?
    businessAllowCreditSales       Boolean        @default(false)
    businessDeliveryControlEnabled Boolean        @default(false)
    businessReceiptLogoUrl         String?
    businessReceiptAddress     String?
    businessReceiptPhone       String?
    businessReceiptEmail       String?
    businessReceiptSocial      String?
    businessReceiptFooterNote  String?
    createdByUserId            String?
    createdBy                  User?          @relation(fields: [createdByUserId], references: [userId])
    createdAt                  DateTime       @default(now())
    updatedAt                  DateTime       @updatedAt

    // Relaciones
    UserGuest     UserGuest[]
    UserBusiness  UserBusiness[]
    subscriptions Subscription[]
    subscriptionPayments SubscriptionPayment[]
    subscriptionCancellations SubscriptionCancellation[]
    taxProviderAccount          TaxProviderAccount?
}

/// Cuenta Auth.cl por empresa (multi-tenant). companyId = businessId del tenant.
model TaxProviderAccount {
    companyId         String            @id
    business          Business          @relation(fields: [companyId], references: [businessId], onDelete: Cascade)
    provider          TaxProviderType   @default(AUTH_CL)
    authApiKey        String?
    authApiSecret     String?
    environment       String            @default("sandbox")
    businessActivity  String?
    businessAddress   String?
    businessCommune   String?
    businessCity      String?
    certificateRef    String?
    certificateStatus CertificateStatus @default(PENDING)
    folioBoletaNext   Int               @default(1)
    folioFacturaNext  Int               @default(1)
    isEnabled         Boolean           @default(false)
    createdAt         DateTime          @default(now())
    updatedAt         DateTime          @updatedAt
}

enum CertificateStatus {
    PENDING
    ACTIVE
    EXPIRED
    REVOKED
}

enum TaxProviderType {
    AUTH_CL
    INTERNAL
}

model UserBusiness {
    userBusinessUserId     String
    userBusinessBusinessId String
    userBusinessRole       Role
    createdAt              DateTime @default(now())
    updatedAt              DateTime @updatedAt
    User                   User     @relation(fields: [userBusinessUserId], references: [userId])
    Business               Business @relation(fields: [userBusinessBusinessId], references: [businessId])

    @@id([userBusinessUserId, userBusinessBusinessId])
}

model UserGuest {
    userGuestId         String          @id
    userGuestEmail      String
    userGuestUserId     String
    userGuestBusinessId String
    userGuestRole       Role
    userGuestStatus     UserGuestStatus
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt

    User     User     @relation(fields: [userGuestUserId], references: [userId])
    Business Business @relation(fields: [userGuestBusinessId], references: [businessId])
}

model Plan {
    planId          String   @id
    planName        String
    planDescription String?
    planFeatures    Json
    planPrice       Float
    planDuration    Int // Duración del plan en meses
    planCurrency    String   @default("CLP")
    planActive      Boolean  @default(true)
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    // Relations
    subscriptions Subscription[]
    subscriptionPayments SubscriptionPayment[]
}

model Subscription {
    subscriptionId            String             @id
    subscriptionBusinessId    String
    subscriptionPlanId        String
    subscriptionStartDate     DateTime
    subscriptionDuration      Int
    subscriptionEndDate       DateTime
    subscriptionStatus        SubscriptionStatus
    subscriptionAmount        Float
    subscriptionPaymentMethod String
    subscriptionPlanFeatures  Json
    createdByUserId           String
    /** Suscripción recurrente Mercado Pago (preapproval) */
    mpPreapprovalId           String?            @unique
    mpPreapprovalStatus       String?
    autoRenewEnabled            Boolean            @default(true)
    /** Fecha en que el cliente solicitó la baja (acceso hasta subscriptionEndDate) */
    subscriptionCancelledAt     DateTime?
    createdAt                 DateTime           @default(now())
    updatedAt                 DateTime           @updatedAt
    createdBy                 User               @relation(fields: [createdByUserId], references: [userId])
    plan                      Plan               @relation(fields: [subscriptionPlanId], references: [planId])
    business                  Business           @relation(fields: [subscriptionBusinessId], references: [businessId])
    payments                  SubscriptionPayment[]
    cancellations             SubscriptionCancellation[]
}

/** Registro inmutable de bajas — auditoría y resolución de reclamos (estilo cancel_at_period_end). */
model SubscriptionCancellation {
    subscriptionCancellationId String   @id @default(uuid())
    subscriptionId             String
    subscriptionBusinessId     String
    subscriptionPlanId         String
    cancelledByUserId          String
    mpPreapprovalId            String?
    planName                   String
    planAmount                 Float
    planCurrency               String   @default("CLP")
    /** Hasta cuándo conserva acceso tras la baja */
    accessValidUntil           DateTime
    confirmationPhrase         String
    cancelReason               String?
    source                     String   @default("PROFILE_SELF_SERVICE")
    requestIp                  String?
    requestUserAgent           String?
    mpResponseSnapshot         Json?
    createdAt                  DateTime @default(now())

    subscription Subscription @relation(fields: [subscriptionId], references: [subscriptionId])
    business     Business     @relation(fields: [subscriptionBusinessId], references: [businessId])
    cancelledBy  User         @relation(fields: [cancelledByUserId], references: [userId])

    @@index([subscriptionBusinessId])
    @@index([subscriptionId])
    @@index([cancelledByUserId])
    @@index([createdAt])
}

model SubscriptionPayment {
    subscriptionPaymentId  String                    @id @default(uuid())
    subscriptionId         String?
    subscriptionBusinessId String
    subscriptionPlanId     String
    amount                 Float
    currency               String                    @default("CLP")
    paymentMethod          SubscriptionPaymentMethod
    status                 SubscriptionPaymentStatus
    externalReference      String?
    mpPreferenceId         String?
    mpPaymentId            String?
    metadata               Json?
    createdByUserId        String
    createdAt              DateTime                  @default(now())
    updatedAt              DateTime                  @updatedAt

    subscription Subscription? @relation(fields: [subscriptionId], references: [subscriptionId])
    business     Business      @relation(fields: [subscriptionBusinessId], references: [businessId])
    plan         Plan          @relation(fields: [subscriptionPlanId], references: [planId])
    createdBy    User          @relation(fields: [createdByUserId], references: [userId])

    @@index([subscriptionBusinessId])
    @@index([status])
    @@index([createdAt])
}

model Ticket {
    ticketId           String         @id @default(uuid())
    ticketNumber       String ?    
    ticketSubject      String?    
    ticketType         TicketType
    ticketStatus       TicketStatus
    ticketAssociatedTo String[]
    createdByUserId    String
    createdAt          DateTime       @default(now())
    updatedAt          DateTime       @updatedAt
    ticketDetails      TicketDetail[]
    createdBy          User           @relation(fields: [createdByUserId], references: [userId])
}

model TicketDetail {
    ticketDetailId      String   @id @default(uuid())
    ticketDetailNumber  String?  
    ticketId            String
    ticketDetailContent String
    ticketDetailImage   String[]
    ticketAssociatedTo  String[]
    createdByUserId     String
    ticketDetailOrigin    TicketDetailOrigin
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
    createdBy           User     @relation(fields: [createdByUserId], references: [userId])
    Ticket              Ticket   @relation(fields: [ticketId], references: [ticketId])
}

model newsletterSubscriber {
    newsletterSubscriberId String   @id @default(uuid())
    email String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

/** Prospectos externos (no usuarios AppsFly) para campaña de outreach */
model PlatformEmailProspect {
    prospectId         String                      @id @default(uuid())
    email              String                      @unique
    firstName          String?
    lastName           String?
    companyName        String?
    status             PlatformEmailProspectStatus @default(ACTIVE)
    unsubscribeToken   String                      @unique @default(uuid())
    unsubscribedAt     DateTime?
    source             String?
    notes              String?
    /** Usuario AppsFly creado tras outreach */
    convertedUserId    String?
    convertedAt        DateTime?
    outreachEmailsSent Int                         @default(0)
    /** Última variante de mensaje enviada (overview | offer | team) */
    lastOutreachVariantId String?
    firstOutreachAt    DateTime?
    lastOutreachAt     DateTime?
    createdAt          DateTime                    @default(now())
    updatedAt          DateTime                    @updatedAt

    @@index([status])
    @@index([email])
    @@index([convertedUserId])
}

enum PlatformEmailProspectStatus {
    ACTIVE
    UNSUBSCRIBED
    CONVERTED
}

/** Campañas de correo de plataforma (panel /admin). Separadas de campañas tenant (ASMR). */
model PlatformEmailCampaign {
    campaignId           String                         @id @default(uuid())
    campaignKey          String?                        @unique
    campaignName         String
    campaignDescription  String?
    campaignStatus       PlatformEmailCampaignStatus    @default(DRAFT)
    audienceType         PlatformEmailAudienceType      @default(ALL_USERS)
    audienceParams       Json?
    scheduleFrequency    PlatformEmailScheduleFrequency @default(MANUAL)
    emailSubject         String?
    emailHtml            String?
    emailText            String?
    messageIntent        String?
    /** Remitente del correo (mismo dominio, distinto por campaña) */
    senderEmail          String?
    senderName           String?
    scheduledAt          DateTime?
    sentAt               DateTime?
    lastRunAt            DateTime?
    totalRecipients      Int                            @default(0)
    totalSent            Int                            @default(0)
    totalDelivered       Int                            @default(0)
    totalFailed          Int                            @default(0)
    totalBounced         Int                            @default(0)
    totalOpened          Int                            @default(0)
    totalClicked         Int                            @default(0)
    createdByUserId      String
    createdBy            User                           @relation(fields: [createdByUserId], references: [userId])
    createdAt            DateTime                       @default(now())
    updatedAt            DateTime                       @updatedAt
    runs                 PlatformEmailCampaignRun[]

    @@index([campaignStatus])
    @@index([createdAt])
    @@index([campaignKey])
}

model PlatformEmailCampaignRun {
    runId           String                           @id @default(uuid())
    campaignId      String
    campaign        PlatformEmailCampaign            @relation(fields: [campaignId], references: [campaignId], onDelete: Cascade)
    runStatus       PlatformEmailCampaignRunStatus   @default(PENDING)
    startedAt       DateTime?
    completedAt     DateTime?
    recipientCount  Int                              @default(0)
    sentCount       Int                              @default(0)
    deliveredCount  Int                              @default(0)
    failedCount     Int                              @default(0)
    bouncedCount    Int                              @default(0)
    openedCount     Int                              @default(0)
    clickedCount    Int                              @default(0)
    errorLog        Json?
    createdAt       DateTime                         @default(now())
    recipients      PlatformEmailCampaignRecipient[]

    @@index([campaignId])
    @@index([runStatus])
}

model PlatformEmailCampaignRecipient {
    recipientId       String                       @id @default(uuid())
    runId             String
    run               PlatformEmailCampaignRun     @relation(fields: [runId], references: [runId], onDelete: Cascade)
    userId            String
    businessId        String?
    recipientEmail    String
    recipientName     String?
    businessName      String?
    deliveryStatus    PlatformEmailRecipientStatus @default(PENDING)
    providerMessageId String?
    errorMessage      String?
    sentAt            DateTime?
    deliveredAt       DateTime?
    bouncedAt         DateTime?
    openedAt          DateTime?
    openCount         Int                          @default(0)
    clickedAt         DateTime?
    clickCount        Int                          @default(0)
    /** Variante A/B/C del outreach (overview, offer, team) */
    messageVariantId  String?
    createdAt         DateTime                     @default(now())

    @@index([messageVariantId])

    @@index([runId])
    @@index([deliveryStatus])
    @@index([recipientEmail])
    @@index([providerMessageId])
}

/** Índice global para webhooks Resend → cotización en BD del tenant */
model QuotationEmailDispatchIndex {
    dispatchId        String   @id @default(uuid())
    businessId        String
    quotationId       String
    providerMessageId String   @unique
    recipientEmail    String
    createdAt         DateTime @default(now())

    @@index([businessId, quotationId])
}

/** Índice global para enlaces públicos de comprobante de venta (sin acceso al sistema) */
model SalePublicShareIndex {
    shareId      String    @id @default(uuid())
    shareToken   String    @unique
    businessId   String
    saleId       String
    expiresAt    DateTime?
    lastAccessAt DateTime?
    createdAt    DateTime  @default(now())

    @@unique([businessId, saleId])
    @@index([shareToken])
}

model PlatformAdminNotification {
    notificationId   String                        @id @default(uuid())
    notificationType PlatformAdminNotificationType @default(CAMPAIGN_SUCCESS)
    title              String
    message            String
    payload            Json?
    campaignId         String?
    isRead             Boolean                       @default(false)
    createdAt          DateTime                      @default(now())

    @@index([isRead])
    @@index([createdAt])
}

/** Cola de tareas para ejecutar con el agente (Cursor) — solo propietario de plataforma */
model PlatformAgentTask {
    taskId          String                    @id @default(uuid())
    title           String
    description     String
    status          PlatformAgentTaskStatus   @default(PENDING)
    priority        PlatformAgentTaskPriority @default(NORMAL)
    safetyStatus    PlatformAgentTaskSafety   @default(APPROVED)
    safetyReason    String?
    createdByUserId String
    createdBy       User                      @relation(fields: [createdByUserId], references: [userId], onDelete: Cascade)
    executionNotes  String?
    executedAt      DateTime?
    createdAt       DateTime                  @default(now())
    updatedAt       DateTime                  @updatedAt

    @@index([status])
    @@index([createdAt])
    @@index([createdByUserId])
}

enum PlatformAgentTaskStatus {
    PENDING
    IN_PROGRESS
    COMPLETED
    CANCELLED
    BLOCKED
}

enum PlatformAgentTaskPriority {
    LOW
    NORMAL
    HIGH
}

enum PlatformAgentTaskSafety {
    APPROVED
    BLOCKED
}

enum PlatformAdminNotificationType {
    CAMPAIGN_SUCCESS
    CAMPAIGN_FAILED
    CAMPAIGN_SKIPPED
    CAMPAIGN_AUTO_RUN
    CAMPAIGN_MANUAL_REQUIRED
}

enum PlatformEmailCampaignStatus {
    DRAFT
    SCHEDULED
    SENDING
    SENT
    FAILED
    ARCHIVED
}

enum PlatformEmailAudienceType {
    ALL_USERS
    CONFIRMED_EMAIL
    PENDING_EMAIL
    ACTIVE_SUBSCRIPTION
    EXPIRED_SUBSCRIPTION
    NEWSLETTER_SUBSCRIBERS
    /** Admins de negocios sin suscripción activa (cuenta suspendida en AppsFly) */
    SUSPENDED_BUSINESS_ADMINS
    /** Admins de negocios cuyo plan vence en 5 días (calendario Chile) */
    BUSINESS_ADMINS_PLAN_EXPIRING_5D
    /** Admins de negocios cuyo plan vence hoy (calendario Chile) */
    BUSINESS_ADMINS_PLAN_EXPIRING_TODAY
    /** Prospectos externos (no registrados en AppsFly) con suscripción activa al correo */
    PLATFORM_PROSPECTS
    CUSTOM_SEGMENT
}

enum PlatformEmailScheduleFrequency {
    MANUAL
    MONTHLY
    DAILY
    WEEKLY
}

enum PlatformEmailRecipientStatus {
    PENDING
    SENT
    DELIVERED
    FAILED
    BOUNCED
}

enum PlatformEmailCampaignRunStatus {
    PENDING
    RUNNING
    COMPLETED
    FAILED
    CANCELLED
}

enum Role {
    ADMIN
    USER
    GUEST
}

enum BusinessStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
    PENDING
}

enum BusinessEntity {
    INDIVIDUAL
    COMPANY
}

enum UserGuestStatus {
    PENDIENT
    ACCEPTED
    REJECTED
    DELETED
}

enum SubscriptionStatus {
    ACTIVE
    INACTIVE
    CANCELLED
    EXPIRED
    PENDIENT
}

enum SubscriptionPaymentMethod {
    MERCADO_PAGO
    PROMO_FREE_TRIAL
}

enum SubscriptionPaymentStatus {
    APPROVED
    PENDING
    REJECTED
}

enum TicketStatus {
    RESOLVED
    IN_PROGRESS
    PENDING
    URGENT
}

enum TicketType {
    SUPPORT
    SUGGESTION
    REQUEST
}

enum TicketDetailOrigin {
   CUSTOMER
   APPSFLY
}




// npx prisma migrate dev --schema=prisma/businessDB/schema.prisma --name init_business
// npx prisma generate --schema ./prisma/businessDB/schema.prisma

generator client {
    provider      = "prisma-client-js"
    output        = "../../src/generated/business"
    binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    userId              String    @id
    userFirstName       String
    userLastName        String
    userEmail           String    @unique
    userLastConnection  DateTime?
    userCodePhoneNumber String?
    userPhoneNumber     String?
    userDocumentType    String?
    userDocumentNumber  String?
    userRole            Role
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    // Relaciones
    customers      Customer[]
    Product        Product[]
    Service        Service[]
    Category       Category[]
    Sale           Sale[]         @relation("SaleCreatedBy")
    salesDelivered Sale[]         @relation("SaleDeliveredBy")
    Payment        Payment[]
    SaleDetail     SaleDetail[]
    Purchase              Purchase[] @relation("PurchaseCreatedBy")
    purchasesCancelled    Purchase[] @relation("PurchaseCancelledBy")
    PurchaseDetail        PurchaseDetail[]
    Provider       Provider[]
    CashExpense    CashExpense[]
    DailySales     DailySales[]
    Transactions   Transactions[]
    Expense            Expense[]
    InventoryMovement  InventoryMovement[]
    AsmrCampaign       AsmrCampaign[]
    Quotation          Quotation[]    @relation("QuotationCreatedBy")
    QuotationDetail    QuotationDetail[]
    Prescription       Prescription[]
    Laboratory         Laboratory[]
    WorkOrder          WorkOrder[]
    LabDispatchCreated LabDispatch[]  @relation("LabDispatchCreatedBy")
    LabDispatchSent    LabDispatch[]  @relation("LabDispatchSentBy")
    PurchaseCertificateCreated PurchaseCertificate[] @relation("PurchaseCertificateCreatedBy")
    PurchaseCertificateIssued  PurchaseCertificate[] @relation("PurchaseCertificateIssuedBy")
}

model Customer {
    customerId              String       @id @default(uuid())
    customerFirstName       String
    customerLastName        String
    customerEmail           String?
    customerCodePhoneNumber String?
    customerPhoneNumber     String?
    customerDocumentType    String?
    customerDocumentNumber  String?
    customerComment         String?
    /** Legacy: fotos históricas. En óptica las imágenes viven en Prescription. */
    customerImageUrl        String?
    /** Fecha de nacimiento (útil en óptica; opcional) */
    customerBirthDate       DateTime?
    /** Dirección (útil en óptica; opcional) */
    customerAddress         String?
    createdAt               DateTime     @default(now())
    updatedAt               DateTime     @updatedAt
    createdByUserId         String
    createdBy               User?        @relation(fields: [createdByUserId], references: [userId])
    Sale                    Sale[]
    SaleDetail              SaleDetail[]
    Quotation               Quotation[]
    QuotationDetail         QuotationDetail[]
    Prescription            Prescription[]
    WorkOrder               WorkOrder[]
}

model Product {
    productId              String           @id @default(uuid())
    productName            String
    productDescription     String?
    productSKU             String           @unique
    categoryId             String
    category               Category         @relation(fields: [categoryId], references: [categoryId])
    productPrice           Int
    productPriceFixed      Boolean?
    productStatus          ProductStatus
    productUnit            ProductUnit
    /** Permite vender el producto aunque quantityOnHand sea 0 o negativo */
    productAllowZeroStock  Boolean          @default(false)
    /** Si true, al venderse puede generar Orden de Trabajo (óptica) */
    productRequiresLabWork Boolean          @default(false)
    createdByUserId        String
    user                   User             @relation(fields: [createdByUserId], references: [userId])
    createdAt              DateTime         @default(now())
    updatedAt              DateTime         @updatedAt
    SaleDetail             SaleDetail[]
    PurchaseDetail         PurchaseDetail[]
    productStock           ProductStock?
    QuotationDetail        QuotationDetail[]
    attributeValues        ProductAttributeValue[]
}

/** Códigos escaneables (barcode/QR/SKU alias) polimórficos por entidad. */
model ScanCode {
    scanCodeId      String   @id @default(uuid())
    /** PRODUCT | SERVICE | WORK_ORDER | CUSTOMER | … */
    entityType      String
    entityId        String
    /** BARCODE | QR | SKU_ALIAS */
    codeType        String
    codeValue       String   @unique
    isPrimary       Boolean  @default(false)
    createdByUserId String?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@index([entityType, entityId])
    @@index([codeType])
}

model ProductStock {
    productId        String   @id
    product          Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)

    quantityOnHand   Int      @default(0)
    reorderPoint     Int      @default(0)
    averageUnitCost  Int      @default(0)
    lastMovementAt   DateTime?
    version          Int      @default(0)

    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    movements        InventoryMovement[]
}

model InventoryMovement {
    movementId      String                  @id @default(uuid())

    productId       String
    productStock    ProductStock            @relation(fields: [productId], references: [productId])

    movementType    InventoryMovementType
    quantityDelta   Int
    stockBefore     Int
    stockAfter      Int

    referenceType   InventoryReferenceType  @default(NONE)
    referenceId     String?
    referenceLabel  String?

    reason          String?
    notes           String?

    createdByUserId String
    user            User                    @relation(fields: [createdByUserId], references: [userId])

    createdAt       DateTime                @default(now())

    @@index([productId, createdAt(sort: Desc)])
    @@index([movementType, createdAt(sort: Desc)])
    @@index([referenceType, referenceId])
    @@index([createdAt(sort: Desc)])
}

model Service {
    serviceId          String           @id @default(uuid())
    serviceName        String
    serviceDescription String?
    serviceSKU         String           @unique
    servicePrice       Int
    servicePriceFixed  Boolean?
    serviceStatus      ProductStatus
    serviceUnit        ServiceUnit
    categoryId         String
    category           Category         @relation(fields: [categoryId], references: [categoryId])
    createdByUserId    String
    user               User             @relation(fields: [createdByUserId], references: [userId])
    createdAt          DateTime         @default(now())
    updatedAt          DateTime         @updatedAt
    SaleDetail         SaleDetail[]
    PurchaseDetail     PurchaseDetail[]
    QuotationDetail    QuotationDetail[]
}

model Category {
    categoryId      String       @id @default(uuid())
    categoryName    String
    /** Código estable de sistema (FRAMES, LENSES, …). Null en categorías custom. */
    categoryCode    String?      @unique
    /** Categorías seed óptica: no eliminables */
    isSystem        Boolean      @default(false)
    createdByUserId String
    allowedFor      UsageContext
    products        Product[]
    services        Service[]
    attributes      CategoryAttribute[]
    user            User         @relation(fields: [createdByUserId], references: [userId])
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt
}

/** Definición de atributo dinámico por categoría (EAV). */
model CategoryAttribute {
    categoryAttributeId String   @id @default(uuid())
    categoryId          String
    category            Category @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)

    attributeKey   String
    attributeLabel String
    /** TEXT | NUMBER | BOOLEAN | SELECT */
    dataType       String   @default("TEXT")
    /** JSON array de opciones para SELECT */
    optionsJson    String?
    isSystem       Boolean  @default(false)
    isRequired     Boolean  @default(false)
    isVisible      Boolean  @default(true)
    sortOrder      Int      @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    values ProductAttributeValue[]

    @@unique([categoryId, attributeKey])
    @@index([categoryId, sortOrder])
}

/** Valor de atributo de un producto (EAV). */
model ProductAttributeValue {
    productAttributeValueId String @id @default(uuid())
    productId               String
    product                 Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

    categoryAttributeId String
    categoryAttribute   CategoryAttribute @relation(fields: [categoryAttributeId], references: [categoryAttributeId], onDelete: Cascade)

    /** Valor serializado a texto; la UI interpreta según dataType */
    value String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([productId, categoryAttributeId])
    @@index([categoryAttributeId])
}

model Sale {
    saleId            String       @id
    saleCustomerId    String
    saleTotal         Int
    saleTotalPayments Int
    salePendingAmount Int
    createdByUserId   String
    saleComment       String?
    /** Comprobante / respaldo visual — URL Cloudinary (opcional) */
    saleImageUrl      String?
    saleNumber        String?
    user              User         @relation("SaleCreatedBy", fields: [createdByUserId], references: [userId])
    customer          Customer     @relation(fields: [saleCustomerId], references: [customerId])
    createdAt         DateTime     @default(now())
    updatedAt         DateTime     @updatedAt
    SaleDetail        SaleDetail[]
    Payment           Payment[]
    taxDocuments      TaxDocument[]
    WorkOrder         WorkOrder[]
    PurchaseCertificate PurchaseCertificate[]
    /** Tipo de comprobante solicitado al registrar la venta */
    documentType      DocumentType @default(RECEIPT)
    /** Control de entrega de productos (independiente del pago) */
    saleDeliveryStatus     SaleDeliveryStatus?
    saleDeliveredAt        DateTime?
    saleDeliveredByUserId  String?
    deliveredBy            User?    @relation("SaleDeliveredBy", fields: [saleDeliveredByUserId], references: [userId])
}

model SaleDetail {
    saleDetailId        String   @id
    saleId              String
    saleDetailProductId String?
    saleDetailServiceId String?
    saleDetailQuantity  Int
    saleDetailPrice     Int
    saleDetailTotal     Int
    saleDetailType      String
    createdByUserId     String
    saleCustomerId      String
    customer            Customer @relation(fields: [saleCustomerId], references: [customerId])
    user                User     @relation(fields: [createdByUserId], references: [userId])
    sale                Sale     @relation(fields: [saleId], references: [saleId])
    product             Product? @relation(fields: [saleDetailProductId], references: [productId])
    service             Service? @relation(fields: [saleDetailServiceId], references: [serviceId])
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
    WorkOrder           WorkOrder[]
}

model Payment {
    paymentId       String   @id
    saleId          String
    paymentAmount   Int
    paymentMethod   String
    createdByUserId String
    user            User     @relation(fields: [createdByUserId], references: [userId])
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    Sale            Sale     @relation(fields: [saleId], references: [saleId])
}

model CashExpense {
    cashExpenseId          String   @id @default(uuid())
    cashExpenseAmount      Int
    cashExpenseDescription String?
    cashExpenseLinkImage   String?
    createdByUserId        String
    createdAt              DateTime @default(now())
    updatedAt              DateTime @updatedAt
    user                   User     @relation(fields: [createdByUserId], references: [userId])
}

model DailySales {
    dailySalesId            String   @id
    dailySalesDay           String   @unique
    dailySalesTotalSales    Int?
    dailySalesNumberOfSales Int?
    dailySalesTotalIncome   Int?
    dailySalesDetailIncome  Json?
    createdByUserId         String
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt
    user                    User     @relation(fields: [createdByUserId], references: [userId])
}

model Transactions {
    transactionId          String   @id @default(uuid())
    transactionType        String?
    transactionMethod      String?
    transactionTable       String?
    transactionRecordId    String?
    transactionOldValue    Json?
    transactionNewValue    Json?
    transactionDescription String?
    createdByUserId        String
    createdAt              DateTime @default(now())
    user                   User     @relation(fields: [createdByUserId], references: [userId])
}

model AsmrCampaign {
    campaignId         String   @id @default(uuid())
    campaignName       String
    campaignType       String
    auditMonth         Int
    auditYear          Int
    sourceMonth        Int
    sourceYear         Int
    discountPercent    Int      @default(20)
    messageSent        String?
    contactsSuccess    Int      @default(0)
    universeTotal      Int      @default(0)
    excludedRepurchase Int      @default(0)
    eligibleBeforeDedup Int     @default(0)
    eligibleFinal      Int      @default(0)
    phonesDeduplicated Int      @default(0)
    campaignStatus     String   @default("SENT")
    createdByUserId    String
    user               User     @relation(fields: [createdByUserId], references: [userId])
    executedAt         DateTime @default(now())
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@index([createdAt(sort: Desc)])
    @@index([auditYear, auditMonth])
}

enum Role {
    ADMIN
    USER
}

model Expense {
    expenseId            String   @id
    expenseDescription   String?
    expensePaymentMethod String?
    expenseImageUrl      String?
    expenseAmount        Int?
    createdByUserId      String
    createdAt            DateTime @default(now())
    user                 User     @relation(fields: [createdByUserId], references: [userId])
}

model Provider {
    providerId              String     @id @default(uuid())
    providerName            String
    providerDocumentType   String?
    providerDocumentNumber  String?
    providerAddress         String?
    providerCodePhoneNumber String?
    providerPhoneNumber     String?
    providerEmail           String?
    providerComment         String?
    createdByUserId         String
    user                    User       @relation(fields: [createdByUserId], references: [userId])
    createdAt               DateTime   @default(now())
    updatedAt               DateTime   @updatedAt
    Purchase                Purchase[]
}

model Purchase {
    purchaseId         String  @id
    purchaseNumber     String?
    purchaseRealNumber String? // Invoice number

    purchaseProviderId String
    provider           Provider @relation(fields: [purchaseProviderId], references: [providerId])

    purchaseTotal   Int
    purchaseStatus  String?
    purchaseComment String?

    createdByUserId String
    user            User   @relation("PurchaseCreatedBy", fields: [createdByUserId], references: [userId])

    cancelledByUserId String?
    cancelledBy       User?    @relation("PurchaseCancelledBy", fields: [cancelledByUserId], references: [userId])
    cancelledAt       DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    PurchaseDetail PurchaseDetail[]
}

model PurchaseDetail {
    purchaseDetailId String   @id
    purchaseId       String
    purchase         Purchase @relation(fields: [purchaseId], references: [purchaseId])

    purchaseDetailProductId String?
    product                 Product? @relation(fields: [purchaseDetailProductId], references: [productId])

    purchaseDetailServiceId String?
    service                 Service? @relation(fields: [purchaseDetailServiceId], references: [serviceId])

    purchaseDetailQuantity Int
    purchaseDetailPrice    Int
    purchaseDetailTotal    Int
    purchaseDetailType     String // PRODUCT or SERVICE

    createdByUserId String
    user            User   @relation(fields: [createdByUserId], references: [userId])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum ProductStatus {
    ACTIVE
    INACTIVE
    DELETED
}

enum ProductUnit {
    UNIT
    KILOGRAM
    GRAM
    LITER
    MILLILITER
    METER
    CENTIMETER
}

enum ServiceUnit {
    UNIT
    MONTH
    DAY
    HOUR
    MINUTE
}

enum UsageContext {
    PRODUCTS
    SERVICES
    BOTH
}

enum InventoryMovementType {
    VENTA
    COMPRA
    AJUSTE_MANUAL
    MERMA
    DEVOLUCION
    ANULACION_VENTA
    ANULACION_COMPRA
}

enum InventoryReferenceType {
    SALE
    SALE_DETAIL
    PURCHASE
    PURCHASE_DETAIL
    MANUAL
    NONE
}

enum DocumentType {
    RECEIPT
    BOLETA
    FACTURA
}

enum SaleDeliveryStatus {
    PENDING
    DELIVERED
}

enum TaxDocumentStatus {
    PENDING
    SENT
    ACCEPTED
    REJECTED
    ERROR
}

enum TaxProviderType {
    AUTH_CL
    INTERNAL
}

model TaxDocument {
    taxDocumentId    String            @id @default(uuid())
    saleId           String
    sale             Sale              @relation(fields: [saleId], references: [saleId], onDelete: Cascade)
    documentType     DocumentType
    provider         TaxProviderType   @default(AUTH_CL)
    folio            Int?
    trackId          String?
    status           TaxDocumentStatus @default(PENDING)
    siiStatus        String?
    pdfUrl           String?
    xmlUrl           String?
    providerResponse Json?
    netAmount        Int?
    taxAmount        Int?
    totalAmount      Int?
    receiverRut      String?
    receiverName     String?
    receiverEmail    String?
    retryCount       Int               @default(0)
    lastError        String?
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @updatedAt
    auditLogs        TaxDocumentAuditLog[]

    @@index([saleId])
    @@index([documentType])
    @@index([status])
    @@index([folio])
    @@index([trackId])
    @@index([receiverRut])
    @@index([createdAt(sort: Desc)])
}

model TaxDocumentAuditLog {
    auditLogId       String             @id @default(uuid())
    taxDocumentId    String
    taxDocument      TaxDocument        @relation(fields: [taxDocumentId], references: [taxDocumentId], onDelete: Cascade)
    action           String
    previousStatus   TaxDocumentStatus?
    newStatus        TaxDocumentStatus?
    payload          Json?
    createdAt        DateTime           @default(now())

    @@index([taxDocumentId])
    @@index([createdAt(sort: Desc)])
}

enum QuotationStatus {
    DRAFT
    SENT
    ACCEPTED
    EXPIRED
}

enum QuotationEmailDeliveryStatus {
    PENDING
    SENT
    DELIVERED
    FAILED
    BOUNCED
}

model Quotation {
    quotationId        String            @id
    quotationNumber    String?
    quotationCustomerId String
    quotationTotal     Int
    quotationStatus    QuotationStatus   @default(DRAFT)
    quotationComment   String?
    quotationExpiresAt DateTime?
    quotationEmailDeliveryStatus QuotationEmailDeliveryStatus?
    quotationEmailProviderMessageId String?
    quotationEmailSentTo String?
    quotationEmailSentAt DateTime?
    quotationEmailDeliveredAt DateTime?
    quotationEmailOpenedAt DateTime?
    quotationEmailErrorMessage String?
    createdByUserId    String
    user               User              @relation("QuotationCreatedBy", fields: [createdByUserId], references: [userId])
    customer           Customer          @relation(fields: [quotationCustomerId], references: [customerId])
    createdAt          DateTime          @default(now())
    updatedAt          DateTime          @updatedAt
    QuotationDetail    QuotationDetail[]
}

model QuotationDetail {
    quotationDetailId        String   @id
    quotationId              String
    quotationDetailProductId String?
    quotationDetailServiceId String?
    quotationDetailQuantity  Int
    quotationDetailPrice     Int
    quotationDetailTotal     Int
    quotationDetailType      String
    createdByUserId          String
    quotationCustomerId      String
    customer                 Customer @relation(fields: [quotationCustomerId], references: [customerId])
    user                     User     @relation(fields: [createdByUserId], references: [userId])
    quotation                Quotation @relation(fields: [quotationId], references: [quotationId], onDelete: Cascade)
    product                  Product? @relation(fields: [quotationDetailProductId], references: [productId])
    service                  Service? @relation(fields: [quotationDetailServiceId], references: [serviceId])
    createdAt                DateTime @default(now())
    updatedAt                DateTime @updatedAt
}

/**
 * Receta óptica asociada a un cliente.
 * Historial: un cliente puede tener muchas recetas.
 * entryMode: PHOTO | MANUAL | MIXED
 */
model Prescription {
    prescriptionId        String   @id @default(uuid())
    customerId            String
    customer              Customer @relation(fields: [customerId], references: [customerId])

    prescriptionDate      DateTime?
    prescriptionExpiresAt DateTime?
    prescribedBy          String?
    /** lejos | cerca | multifocal | progresivo | otro */
    prescriptionType      String?

    odSphere              String?
    odCylinder            String?
    odAxis                String?
    odAddition            String?
    odPrism               String?
    odBase                String?

    oiSphere              String?
    oiCylinder            String?
    oiAxis                String?
    oiAddition            String?
    oiPrism               String?
    oiBase                String?

    pdBinocular           String?
    pdOd                  String?
    pdOi                  String?
    pdNear                String?

    prescriptionNotes     String?
    /** Foto/archivo de la receta — URL Cloudinary (opcional) */
    prescriptionImageUrl  String?
    /** PHOTO | MANUAL | MIXED */
    entryMode             String   @default("MANUAL")

    createdByUserId       String
    createdBy             User     @relation(fields: [createdByUserId], references: [userId])
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    WorkOrder             WorkOrder[]

    @@index([customerId, createdAt(sort: Desc)])
}

enum WorkOrderStatus {
    CREATED
    PENDING_SHIPMENT
    SENT_TO_LAB
    RECEIVED
    QUALITY_CONTROL
    READY_FOR_DELIVERY
    DELIVERED
}

enum LabDispatchStatus {
    SENT
    PARTIAL_RECEIVED
    RECEIVED
    CANCELLED
}

/** Laboratorio óptico (tallado / montaje) */
model Laboratory {
    laboratoryId              String        @id @default(uuid())
    laboratoryName            String
    laboratoryDocumentType    String?
    laboratoryDocumentNumber  String?
    laboratoryAddress         String?
    laboratoryCodePhoneNumber String?
    laboratoryPhoneNumber     String?
    laboratoryEmail           String?
    laboratoryComment         String?
    laboratoryActive          Boolean       @default(true)
    createdByUserId           String
    createdBy                 User          @relation(fields: [createdByUserId], references: [userId])
    createdAt                 DateTime      @default(now())
    updatedAt                 DateTime      @updatedAt
    WorkOrder                 WorkOrder[]
    LabDispatch               LabDispatch[]
}

/**
 * Orden de Trabajo (OT) — flujo óptico asociado a una venta.
 * Una venta puede tener varias OT (p. ej. un producto óptico por OT).
 */
model WorkOrder {
    workOrderId        String          @id @default(uuid())
    workOrderNumber    String?
    saleId             String
    sale               Sale            @relation(fields: [saleId], references: [saleId])
    saleDetailId       String?
    saleDetail         SaleDetail?     @relation(fields: [saleDetailId], references: [saleDetailId])
    customerId         String
    customer           Customer        @relation(fields: [customerId], references: [customerId])
    prescriptionId     String?
    prescription       Prescription?   @relation(fields: [prescriptionId], references: [prescriptionId])
    laboratoryId       String?
    laboratory         Laboratory?     @relation(fields: [laboratoryId], references: [laboratoryId])
    labDispatchId      String?
    labDispatch        LabDispatch?    @relation(fields: [labDispatchId], references: [labDispatchId])
    workOrderStatus    WorkOrderStatus @default(CREATED)
    workOrderNotes     String?
    workOrderLabNotes  String?
    quantity           Int             @default(1)
    receivedAt         DateTime?
    deliveredAt        DateTime?
    createdByUserId    String
    createdBy          User            @relation(fields: [createdByUserId], references: [userId])
    createdAt          DateTime        @default(now())
    updatedAt          DateTime        @updatedAt

    @@index([saleId])
    @@index([customerId, createdAt(sort: Desc)])
    @@index([laboratoryId, workOrderStatus])
    @@index([labDispatchId])
    @@index([workOrderStatus, createdAt(sort: Desc)])
}

/**
 * Despacho a laboratorio: agrupa varias OT del mismo laboratorio en un envío.
 * La recepción de OT puede ser parcial (por OT).
 */
model LabDispatch {
    labDispatchId     String            @id @default(uuid())
    labDispatchNumber String?
    laboratoryId      String
    laboratory        Laboratory        @relation(fields: [laboratoryId], references: [laboratoryId])
    labDispatchStatus LabDispatchStatus @default(SENT)
    sentAt            DateTime?
    sentByUserId      String?
    sentBy            User?             @relation("LabDispatchSentBy", fields: [sentByUserId], references: [userId])
    labDispatchNotes  String?
    createdByUserId   String
    createdBy         User              @relation("LabDispatchCreatedBy", fields: [createdByUserId], references: [userId])
    createdAt         DateTime          @default(now())
    updatedAt         DateTime          @updatedAt
    WorkOrder         WorkOrder[]

    @@index([laboratoryId, createdAt(sort: Desc)])
    @@index([labDispatchStatus, createdAt(sort: Desc)])
}

enum PurchaseCertificateStatus {
    DRAFT
    ISSUED
    VOID
}

/**
 * Certificado de compra (óptica) — documento independiente para reembolsos
 * (ISAPRE, FONASA, seguros, convenios). No modifica la venta original.
 * Las líneas son un snapshot editable al emitir.
 */
model PurchaseCertificate {
    purchaseCertificateId    String                    @id @default(uuid())
    saleId                   String
    sale                     Sale                      @relation(fields: [saleId], references: [saleId])
    certificateNumber        String?
    certificateStatus        PurchaseCertificateStatus @default(DRAFT)

    /** Fecha impresa en el certificado (editable) */
    certificateIssuedDate    DateTime?
    certificateComment       String?
    /** Nombre que aparece en firma del responsable */
    certificateResponsibleName String?

    customerNameSnapshot     String?
    customerDocumentSnapshot String?
    businessNameSnapshot     String?
    businessDocumentSnapshot String?
    businessAddressSnapshot  String?
    businessLogoSnapshot     String?

    certificateTotal         Int                       @default(0)

    issuedAt                 DateTime?
    issuedByUserId           String?
    issuedBy                 User?                     @relation("PurchaseCertificateIssuedBy", fields: [issuedByUserId], references: [userId])
    createdByUserId          String
    createdBy                User                      @relation("PurchaseCertificateCreatedBy", fields: [createdByUserId], references: [userId])
    createdAt                DateTime                  @default(now())
    updatedAt                DateTime                  @updatedAt

    details                  PurchaseCertificateDetail[]

    @@index([saleId, createdAt(sort: Desc)])
    @@index([certificateStatus, createdAt(sort: Desc)])
}

model PurchaseCertificateDetail {
    purchaseCertificateDetailId String              @id @default(uuid())
    purchaseCertificateId       String
    purchaseCertificate         PurchaseCertificate @relation(fields: [purchaseCertificateId], references: [purchaseCertificateId], onDelete: Cascade)

    /** Referencia blanda a la línea de venta (sin FK; solo auditoría) */
    sourceSaleDetailId          String?
    lineType                    String?
    lineSku                     String?
    lineDescription             String
    lineQuantity                Int                 @default(1)
    lineUnitPrice               Int                 @default(0)
    lineTotal                   Int                 @default(0)
    sortOrder                   Int                 @default(0)
    /** Si false, no se imprime en el PDF (permite omitir líneas sin borrar) */
    lineIncluded                Boolean             @default(true)

    createdAt                   DateTime            @default(now())
    updatedAt                   DateTime            @updatedAt

    @@index([purchaseCertificateId, sortOrder])
}

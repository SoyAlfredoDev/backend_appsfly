// npx prisma migrate dev --schema=prisma/businessDB/schema.prisma --name init_business
// npx prisma generate --schema ./prisma/businessDB/schema.prisma

generator client {
    provider      = "prisma-client-js"
    output        = "../../src/generated/business"
    binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    userId              String    @id
    userFirstName       String
    userLastName        String
    userEmail           String    @unique
    userLastConnection  DateTime?
    userCodePhoneNumber String?
    userPhoneNumber     String?
    userDocumentType    String?
    userDocumentNumber  String?
    userRole            Role
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    // Relaciones
    customers      Customer[]
    Product        Product[]
    Service        Service[]
    Category       Category[]
    Sale           Sale[]
    Payment        Payment[]
    SaleDetail     SaleDetail[]
    Purchase              Purchase[] @relation("PurchaseCreatedBy")
    purchasesCancelled    Purchase[] @relation("PurchaseCancelledBy")
    PurchaseDetail        PurchaseDetail[]
    Provider       Provider[]
    CashExpense    CashExpense[]
    DailySales     DailySales[]
    Transactions   Transactions[]
    Expense            Expense[]
    InventoryMovement  InventoryMovement[]
    AsmrCampaign       AsmrCampaign[]
}

model Customer {
    customerId              String       @id @default(uuid())
    customerFirstName       String
    customerLastName        String
    customerEmail           String?
    customerCodePhoneNumber String?
    customerPhoneNumber     String?
    customerDocumentType    String?
    customerDocumentNumber  String?
    customerComment         String?
    /** Foto de perfil — URL Cloudinary (opcional) */
    customerImageUrl        String?
    createdAt               DateTime     @default(now())
    updatedAt               DateTime     @updatedAt
    createdByUserId         String
    createdBy               User?        @relation(fields: [createdByUserId], references: [userId])
    Sale                    Sale[]
    SaleDetail              SaleDetail[]
}

model Product {
    productId              String           @id @default(uuid())
    productName            String
    productDescription     String?
    productSKU             String           @unique
    categoryId             String
    category               Category         @relation(fields: [categoryId], references: [categoryId])
    productPrice           Int
    productPriceFixed      Boolean?
    productStatus          ProductStatus
    productUnit            ProductUnit
    /** Permite vender el producto aunque quantityOnHand sea 0 o negativo */
    productAllowZeroStock  Boolean          @default(false)
    createdByUserId        String
    user                   User             @relation(fields: [createdByUserId], references: [userId])
    createdAt              DateTime         @default(now())
    updatedAt              DateTime         @updatedAt
    SaleDetail             SaleDetail[]
    PurchaseDetail         PurchaseDetail[]
    productStock           ProductStock?
}

model ProductStock {
    productId        String   @id
    product          Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)

    quantityOnHand   Int      @default(0)
    reorderPoint     Int      @default(0)
    averageUnitCost  Int      @default(0)
    lastMovementAt   DateTime?
    version          Int      @default(0)

    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    movements        InventoryMovement[]
}

model InventoryMovement {
    movementId      String                  @id @default(uuid())

    productId       String
    productStock    ProductStock            @relation(fields: [productId], references: [productId])

    movementType    InventoryMovementType
    quantityDelta   Int
    stockBefore     Int
    stockAfter      Int

    referenceType   InventoryReferenceType  @default(NONE)
    referenceId     String?
    referenceLabel  String?

    reason          String?
    notes           String?

    createdByUserId String
    user            User                    @relation(fields: [createdByUserId], references: [userId])

    createdAt       DateTime                @default(now())

    @@index([productId, createdAt(sort: Desc)])
    @@index([movementType, createdAt(sort: Desc)])
    @@index([referenceType, referenceId])
    @@index([createdAt(sort: Desc)])
}

model Service {
    serviceId          String           @id @default(uuid())
    serviceName        String
    serviceDescription String?
    serviceSKU         String           @unique
    servicePrice       Int
    servicePriceFixed  Boolean?
    serviceStatus      ProductStatus
    serviceUnit        ServiceUnit
    categoryId         String
    category           Category         @relation(fields: [categoryId], references: [categoryId])
    createdByUserId    String
    user               User             @relation(fields: [createdByUserId], references: [userId])
    createdAt          DateTime         @default(now())
    updatedAt          DateTime         @updatedAt
    SaleDetail         SaleDetail[]
    PurchaseDetail     PurchaseDetail[]
}

model Category {
    categoryId      String       @id @default(uuid())
    categoryName    String
    createdByUserId String
    allowedFor      UsageContext
    products        Product[]
    services        Service[]
    user            User         @relation(fields: [createdByUserId], references: [userId])
    createdAt       DateTime     @default(now())
    updatedAt       DateTime     @updatedAt
}

model Sale {
    saleId            String       @id
    saleCustomerId    String
    saleTotal         Int
    saleTotalPayments Int
    salePendingAmount Int
    createdByUserId   String
    saleComment       String?
    /** Comprobante / respaldo visual — URL Cloudinary (opcional) */
    saleImageUrl      String?
    saleNumber        String?
    user              User         @relation(fields: [createdByUserId], references: [userId])
    customer          Customer     @relation(fields: [saleCustomerId], references: [customerId])
    createdAt         DateTime     @default(now())
    updatedAt         DateTime     @updatedAt
    SaleDetail        SaleDetail[]
    Payment           Payment[]
}

model SaleDetail {
    saleDetailId        String   @id
    saleId              String
    saleDetailProductId String?
    saleDetailServiceId String?
    saleDetailQuantity  Int
    saleDetailPrice     Int
    saleDetailTotal     Int
    saleDetailType      String
    createdByUserId     String
    saleCustomerId      String
    customer            Customer @relation(fields: [saleCustomerId], references: [customerId])
    user                User     @relation(fields: [createdByUserId], references: [userId])
    sale                Sale     @relation(fields: [saleId], references: [saleId])
    product             Product? @relation(fields: [saleDetailProductId], references: [productId])
    service             Service? @relation(fields: [saleDetailServiceId], references: [serviceId])
    createdAt           DateTime @default(now())
    updatedAt           DateTime @updatedAt
}

model Payment {
    paymentId       String   @id
    saleId          String
    paymentAmount   Int
    paymentMethod   String
    createdByUserId String
    user            User     @relation(fields: [createdByUserId], references: [userId])
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    Sale            Sale     @relation(fields: [saleId], references: [saleId])
}

model CashExpense {
    cashExpenseId          String   @id @default(uuid())
    cashExpenseAmount      Int
    cashExpenseDescription String?
    cashExpenseLinkImage   String?
    createdByUserId        String
    createdAt              DateTime @default(now())
    updatedAt              DateTime @updatedAt
    user                   User     @relation(fields: [createdByUserId], references: [userId])
}

model DailySales {
    dailySalesId            String   @id
    dailySalesDay           String   @unique
    dailySalesTotalSales    Int?
    dailySalesNumberOfSales Int?
    dailySalesTotalIncome   Int?
    dailySalesDetailIncome  Json?
    createdByUserId         String
    createdAt               DateTime @default(now())
    updatedAt               DateTime @updatedAt
    user                    User     @relation(fields: [createdByUserId], references: [userId])
}

model Transactions {
    transactionId          String   @id @default(uuid())
    transactionType        String?
    transactionMethod      String?
    transactionTable       String?
    transactionRecordId    String?
    transactionOldValue    Json?
    transactionNewValue    Json?
    transactionDescription String?
    createdByUserId        String
    createdAt              DateTime @default(now())
    user                   User     @relation(fields: [createdByUserId], references: [userId])
}

model AsmrCampaign {
    campaignId         String   @id @default(uuid())
    campaignName       String
    campaignType       String
    auditMonth         Int
    auditYear          Int
    sourceMonth        Int
    sourceYear         Int
    discountPercent    Int      @default(20)
    messageSent        String?
    contactsSuccess    Int      @default(0)
    universeTotal      Int      @default(0)
    excludedRepurchase Int      @default(0)
    eligibleBeforeDedup Int     @default(0)
    eligibleFinal      Int      @default(0)
    phonesDeduplicated Int      @default(0)
    campaignStatus     String   @default("SENT")
    createdByUserId    String
    user               User     @relation(fields: [createdByUserId], references: [userId])
    executedAt         DateTime @default(now())
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt

    @@index([createdAt(sort: Desc)])
    @@index([auditYear, auditMonth])
}

enum Role {
    ADMIN
    USER
}

model Expense {
    expenseId            String   @id
    expenseDescription   String?
    expensePaymentMethod String?
    expenseImageUrl      String?
    expenseAmount        Int?
    createdByUserId      String
    createdAt            DateTime @default(now())
    user                 User     @relation(fields: [createdByUserId], references: [userId])
}

model Provider {
    providerId              String     @id @default(uuid())
    providerName            String
    providerDocumentType   String?
    providerDocumentNumber  String?
    providerAddress         String?
    providerCodePhoneNumber String?
    providerPhoneNumber     String?
    providerEmail           String?
    providerComment         String?
    createdByUserId         String
    user                    User       @relation(fields: [createdByUserId], references: [userId])
    createdAt               DateTime   @default(now())
    updatedAt               DateTime   @updatedAt
    Purchase                Purchase[]
}

model Purchase {
    purchaseId         String  @id
    purchaseNumber     String?
    purchaseRealNumber String? // Invoice number

    purchaseProviderId String
    provider           Provider @relation(fields: [purchaseProviderId], references: [providerId])

    purchaseTotal   Int
    purchaseStatus  String?
    purchaseComment String?

    createdByUserId String
    user            User   @relation("PurchaseCreatedBy", fields: [createdByUserId], references: [userId])

    cancelledByUserId String?
    cancelledBy       User?    @relation("PurchaseCancelledBy", fields: [cancelledByUserId], references: [userId])
    cancelledAt       DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    PurchaseDetail PurchaseDetail[]
}

model PurchaseDetail {
    purchaseDetailId String   @id
    purchaseId       String
    purchase         Purchase @relation(fields: [purchaseId], references: [purchaseId])

    purchaseDetailProductId String?
    product                 Product? @relation(fields: [purchaseDetailProductId], references: [productId])

    purchaseDetailServiceId String?
    service                 Service? @relation(fields: [purchaseDetailServiceId], references: [serviceId])

    purchaseDetailQuantity Int
    purchaseDetailPrice    Int
    purchaseDetailTotal    Int
    purchaseDetailType     String // PRODUCT or SERVICE

    createdByUserId String
    user            User   @relation(fields: [createdByUserId], references: [userId])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum ProductStatus {
    ACTIVE
    INACTIVE
    DELETED
}

enum ProductUnit {
    UNIT
    KILOGRAM
    GRAM
    LITER
    MILLILITER
    METER
    CENTIMETER
}

enum ServiceUnit {
    UNIT
    MONTH
    DAY
    HOUR
    MINUTE
}

enum UsageContext {
    PRODUCTS
    SERVICES
    BOTH
}

enum InventoryMovementType {
    VENTA
    COMPRA
    AJUSTE_MANUAL
    MERMA
    DEVOLUCION
    ANULACION_VENTA
    ANULACION_COMPRA
}

enum InventoryReferenceType {
    SALE
    SALE_DETAIL
    PURCHASE
    PURCHASE_DETAIL
    MANUAL
    NONE
}

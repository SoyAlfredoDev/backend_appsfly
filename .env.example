# AppsFly Backend — variables de entorno
# Copiar a .env (local) o configurar en el host de producción.

# Mercado Pago Chile — credenciales PRIVADAS (nunca en frontend/Vercel)
# Obtener en: https://www.mercadopago.cl/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=

# Firma Webhooks (x-signature) — panel MP → Webhooks → Secret signature
# Distinto del Access Token; se genera al guardar la URL de notificaciones.
MERCADO_PAGO_WEBHOOK_SECRET=

# Alertas internas de pagos de suscripción (opcional; default: appsfly.cl@gmail.com)
APPSFLY_ADMIN_EMAIL=appsfly.cl@gmail.com

# URLs de la aplicación
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
FRONTEND_URL_PRODUCTION=https://appsfly.app
BACKEND_URL_PRODUCTION=https://api.appsfly.app

# Logo en correos (logo-appsfly-white.png servido desde el frontend)
# Default: {FRONTEND_URL_PRODUCTION}/logo-appsfly-white.png
APPSFLY_EMAIL_LOGO_URL=

# Asistente IA (solo admins del negocio) — Google AI Studio (gratis)
# Obtener en: https://aistudio.google.com/apikey
# Las claves nuevas empiezan con AQ. — usar header x-goog-api-key (ya soportado en el backend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Campañas email automáticas (día 5 de cada mes, 09:00 Chile)
AUTO_CAMPAIGN_RUN_DAY=5
AUTO_CAMPAIGN_RUN_HOUR=9
# DISABLE_CAMPAIGN_SCHEDULER=true
# Si el servidor estuvo apagado, al encender recupera el último ciclo perdido (lun/mié/vie, diario, mensual)
# En Vercel el scheduler local no corre; usar CRON_SECRET + cron en vercel.json (cada 15 min)
CRON_SECRET=

# Resend — envío y webhooks de campañas de email (panel /admin)
# API key: https://resend.com/api-keys
RESEND_API_KEY=
# Dominio y remitente por defecto (campañas usan remitentes propios en appsfly.app)
PLATFORM_EMAIL_DOMAIN=appsfly.app
PLATFORM_EMAIL_DEFAULT_FROM=AppsFly <noreply@appsfly.app>
# Webhook Resend → URL: {BACKEND_URL}/api/webhooks/resend
# Eventos: email.sent, email.delivered, email.bounced, email.opened, email.complained
# Clics en registro (prospectos): {BACKEND_URL}/api/prospects/register-click/{recipientId}
#   → redirige a /register?from=prospect-email (tracking por destinatario de campaña)
# Secret: panel Resend → Webhooks → Signing secret
RESEND_WEBHOOK_SECRET=

# Auth.cl — facturación electrónica Chile (DTE)
# Documentación: https://auth.cl | API: https://yamt.com/api
AUTH_API_KEY=
AUTH_API_SECRET=
AUTH_API_ENVIRONMENT=sandbox
# AUTH_API_BASE_URL=https://api.yamt.com
# AUTH_CREDENTIALS_ENCRYPTION_KEY=  # cifrado credenciales por empresa (openssl rand -hex 32)
# TAX_DOCUMENT_RETRY_MAX=3
 — único usuario autorizado para cola de tareas del agente
PLATFORM_OWNER_EMAIL=soyalfredo.dev@gmail.com

# Token local — gestión/ejecución de cola solo desde PC con el mismo valor en frontend
# Generar: openssl rand -hex 24
# Header HTTP: X-AppsFly-Agent-Token
# POST crear tareas NO requiere token (móvil puede agregar). Sin definir = sin restricción extra.
AGENT_TASKS_LOCAL_TOKEN=
# Resend gratuito: 100 correos/día — prospectos usan 70, quedan 30 para avisos de plan
# Envío automático prospectos: lunes, miércoles y viernes a AUTO_CAMPAIGN_RUN_HOUR (Chile)
# Máximo 1 correo por prospecto al mes; cola justa; 3 variantes de mensaje
PROSPECT_OUTREACH_MAX_PER_RUN=70
PROSPECT_OUTREACH_MAX_PER_SENDER=18
PROSPECT_OUTREACH_SEND_DELAY_MS=180

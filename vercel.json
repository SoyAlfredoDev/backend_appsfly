{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/mp-subscription-renewals",
      "schedule": "30 15 * * *"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{api/server.js,src/generated/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/mp-subscription-renewals",
      "schedule": "30 15 * * *"
    }
  ]
}
